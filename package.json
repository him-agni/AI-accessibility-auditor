{
  "name": "clarity-accessibility-scanner",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "test:build": "esbuild lib/fixes/index.ts lib/scan/normalize.ts lib/scan/keyboard.ts lib/scan/forms.ts lib/scan/viewport.ts --bundle --format=esm --platform=neutral --outdir=dist/test --out-extension:.js=.mjs",
    "test": "npm run build && npm run test:build && node --test tests/rendered-html.test.mjs tests/fix-provider.test.mjs tests/normalize.test.mjs tests/heuristics.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy": "npm run build && wrangler deploy -c dist/server/wrangler.json"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "axe-core": "4.13.0",
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vinext": "0.0.50"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
